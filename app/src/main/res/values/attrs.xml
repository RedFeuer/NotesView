<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NoteStackView">
        <!-- Кастомные атрибуты для NoteStackView -->
        <attr name="stackMaxSize" format="integer"/>
        <attr name="stackSpacingVertically" format="dimension"/>
        <attr name="stackSpacingHorizontally" format="dimension"/>
        <attr name="stackCollapseTextSize" format="dimension"/>
        <attr name="stackHorizontalPadding" format="dimension"/>
        <attr name="stackVerticalPadding" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="NoteView">
        <!-- Кастомные атрибуты для NoteView -->
        <attr name="title" format="string"/>
        <attr name="isImportant" format="boolean"/>
        <attr name="isViewed" format="boolean"/>
        <attr name="description" format="string"/>
        <attr name="createdAtText" format="string"/>

        <!-- Цвета -->
        <attr name="cardColor" format="reference|color"/>
        <attr name="headerColor" format="reference|color"/>
        <attr name="titleTextColor" format="reference|color"/>
        <attr name="descriptionTextColor" format="reference|color"/>
        <attr name="createdAtTextColor" format="reference|color"/>

        <!-- Размеры -->
        <attr name="noteCornerRadius" format="dimension"/>
        <attr name="noteElevation" format="dimension"/>
    </declare-styleable>
</resources>